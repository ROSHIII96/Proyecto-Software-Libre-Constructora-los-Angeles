; /etc/bind/db.losangeles.internal -- zona del proyecto
$TTL 604800
@   IN  SOA ns1.losangeles.internal. admin.losangeles.internal. (
            3       ; Serial
       604800       ; Refresh
        86400       ; Retry
      2419200       ; Expire
       604800 )     ; Negative Cache TTL

; Registros NS
@   IN  NS  ns1.losangeles.internal.

; Registros A
ns1          IN  A  192.168.50.1
@            IN  A  192.168.50.1
capacitacion IN  A  192.168.50.1
ftp          IN  A  192.168.50.1

; CNAMEs
www          IN  CNAME capacitacion.losangeles.internal.
