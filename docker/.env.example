# Copie este archivo a .env (cp .env.example .env) y cambie las claves.
# El archivo .env NO se sube a Git (esta en .gitignore).
# Despues: chmod 600 .env

# --- Base de datos (mariadb:11.8) ---
MARIADB_ROOT_PASSWORD=CambieEstaClaveRoot
DB_NAME=chamilo
DB_USER=chamilo_user
DB_PASS=CambieEstaClaveApp

# --- Imagen de Chamilo (la construye Integrante 2; TODOS usan estos mismos valores) ---
CHAMILO_VERSION=1.11.40
PHP_VERSION=8.3
CHAMILO_URL=https://github.com/chamilo/chamilo-lms/releases/download/v1.11.40/chamilo-1.11.40.zip
# Resultado de: sha256sum nombre-del-zip.zip  (queda registrado en docs/versiones.md)
CHAMILO_SHA256=PEGUE_AQUI_EL_SHA256

# --- Instalacion automatica de Chamilo (primer arranque) ---
CHAMILO_PORTAL_URL=https://capacitacion.losangeles.internal/
CHAMILO_ADMIN_USER=admin
CHAMILO_ADMIN_PASS=CambieEstaClaveAdmin.1
CHAMILO_ADMIN_EMAIL=admin@losangeles.internal
# Clave de las cuentas de ejemplo (Instructor1, estudiante1, Estudiante2, Estudiante3)
CHAMILO_DEMO_PASS=CambieEstaClaveDemo.1
