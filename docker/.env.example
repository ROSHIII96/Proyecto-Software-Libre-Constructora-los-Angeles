# Copie este archivo a .env (cp .env.example .env) y cambie las claves.
# El archivo .env NO se sube a Git (esta en .gitignore).
# Despues: chmod 600 .env

# --- Base de datos (mariadb:11.8) ---
MARIADB_ROOT_PASSWORD=CambieEstaClaveRoot
DB_NAME=chamilo
DB_USER=chamilo_user
DB_PASS=CambieEstaClaveApp

# --- Imagen de Chamilo (la construye Integrante 2; TODOS usan estos mismos valores) ---
CHAMILO_VERSION=1.11.40
PHP_VERSION=8.3
# Copie la URL EXACTA del paquete .zip de la pagina de Releases v1.11.40 de Chamilo
CHAMILO_URL=PEGUE_AQUI_LA_URL_DEL_ZIP
# Resultado de: sha256sum nombre-del-zip.zip  (queda registrado en docs/versiones.md)
CHAMILO_SHA256=PEGUE_AQUI_EL_SHA256
